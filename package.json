{
  "name": "opencode-status-indicator",
  "version": "0.2.0",
  "description": "OpenCode v2 TUI plugin: shows whether the active request is in the PREFILL stage or DECODING, Claude-Code style (up/down arrow)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshithmohan/opencode-status-indicator.git"
  },
  "homepage": "https://github.com/harshithmohan/opencode-status-indicator#readme",
  "bugs": {
    "url": "https://github.com/harshithmohan/opencode-status-indicator/issues"
  },
  "exports": {
    "./tui": {
      "import": "./dist/tui.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opentui/solid": "*",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2"
  }
}
